config TOUCHSCREEN_ATMEL_MXT641T_PANTECH
	bool "Pantech Atmel mXT641T touchscreen"
	depends on I2C && INPUT_TOUCHSCREEN
	help
	  Pantech's Atmel mXT641T driver, used with the NT35695 panel of
	  the EF71S.

config TOUCHSCREEN_FT8716_PANTECH
	bool "FocalTech FT8716 in-cell touchscreen (EF71AS)"
	depends on I2C && INPUT_TOUCHSCREEN
	help
	  FocalTech's FT8716 driver (Qualcomm_Ver 1.3.1), as used with the
	  FT8716 panel of the EF71AS.
