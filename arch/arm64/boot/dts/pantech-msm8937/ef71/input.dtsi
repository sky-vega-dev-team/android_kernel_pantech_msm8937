#include <dt-bindings/input/atmel-maxtouch.h>

&i2c_3 { /* BLSP1 QUP3 */
	status = "ok";
	clock-frequency = <400000>;

	/* EF71S (NT35695 panel): Atmel mXT641T */
	atmel@4a {
		compatible = "atmel,maxtouch", "atmel,atmel_mxt_641t";
		reg = <0x4a>;
		interrupt-parent = <&tlmm>;
		interrupts = <65 0x2008>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;

		atmel,reset-gpio = <&tlmm 64 0x00>;
		atmel,irq-gpio = <&tlmm 65 0x2008>;
		atmel,iovdd-gpio = <&tlmm 39 0x00>;
		atmel,wakeup-method = <ATMEL_MXT_WAKEUP_I2C_SCL>;

		pantech,panel = "nt35695";
	};

	/* EF71AS: FocalTech FT8716, on the same GPIOs */
	focaltech@38 {
		compatible = "focaltech,fts";
		reg = <0x38>;
		interrupt-parent = <&tlmm>;
		interrupts = <65 0x2008>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		focaltech,name = "fts";
		focaltech,family-id = <0x87>;
		focaltech,reset-gpio = <&tlmm 64 0x00>;
		focaltech,irq-gpio = <&tlmm 65 0x2008>;
		focaltech,display-coords = <0 0 1080 1920>;
		focaltech,panel-coords = <0 0 1080 1920>;
		focaltech,no-force-update;
		focaltech,i2c-pull-up;
		focaltech,group-id = <1>;
		focaltech,hard-reset-delay-ms = <20>;
		focaltech,soft-reset-delay-ms = <300>;
		focaltech,num-max-touches = <10>;
		focaltech,fw-name = "FT_Upgrade_App.i";
		focaltech,fw-delay-aa-ms = <50>;
		focaltech,fw-delay-55-ms = <30>;
		focaltech,fw-upgrade-id1 = <0x87>;
		focaltech,fw-upgrade-id2 = <0xa6>;
		focaltech,fw-delay-readid-ms = <10>;
		focaltech,fw-delay-era-flsh-ms = <2000>;
		/* The FT8716 reports both axes mirrored */
		pantech,x-flip;
		pantech,y-flip;
		pantech,panel = "ft8716";
	};
};

&soc {
	gpio_keys {
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_key_wheel_active>;

		/delete-node/ camera_focus;
		/delete-node/ camera_snapshot;
		/delete-node/ vol_up;

		wheel_key {
			label = "wheel_key";
			gpios = <&tlmm 126 0x1>;
			linux,input-type = <1>;
			linux,code = <250>;
			gpio-key,wakeup;
			debounce-interval = <15>;
		};
	};

	/* Rotary wheel (volume), GPIO 127/128 are the two encoder terminals */
	gpio_wheel_alps_ec05e {
		compatible = "gpio-wheel-alps-ec05e";
		input-name = "gpio-wheel-alps-ec05e";
		pinctrl-names = "tlmm_gpio_wheel_alps_ec05e_active",
				"tlmm_gpio_wheel_alps_ec05e_suspend";
		pinctrl-0 = <&gpio_wheel_alps_ec05e_active>;
		pinctrl-1 = <&gpio_wheel_alps_ec05e_suspend>;

		terminal_a { /* Wheel down */
			label = "terminal_a";
			gpios = <&tlmm 128 0x1>;
		};

		terminal_b { /* Wheel up */
			label = "terminal_b";
			gpios = <&tlmm 127 0x1>;
		};
	};
};

&spmi_bus {
	qcom,pm8937@0 {
		qcom,power-on@800 {
			/delete-property/ qcom,store-hard-reset-reason;

			/* RESIN is not a volume key here, the wheel is */
			qcom,pon_2 {
				/delete-property/ linux,code;
			};
		};
	};
};
