# Pantech EF71 (MSM8937): built in, the boot test runs from an initramfs
CONFIG_MSM_GCC_8917=y
CONFIG_PINCTRL_MSM8917=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_MSM8937=y
CONFIG_PHY_QCOM_USB_HS_28NM=y
CONFIG_EXTCON_USB_DUMMY=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PANIC_TIMEOUT=5
# Display
# CONFIG_QCOM_OCMEM is not set
# CONFIG_QCOM_LLCC is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_PANTECH_EF71_NT35695=y
# Charger and fuel gauge
CONFIG_CHARGER_QCOM_SMBCHG=y
CONFIG_BATTERY_PMI8994_FG=y
