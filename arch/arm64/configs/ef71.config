# Pantech EF71 (MSM8937): built in, the boot test runs from an initramfs
CONFIG_MSM_GCC_8917=y
CONFIG_PINCTRL_MSM8917=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_MSM8937=y
CONFIG_PHY_QCOM_USB_HS_28NM=y
CONFIG_EXTCON_USB_DUMMY=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PANIC_TIMEOUT=5
# Display
# CONFIG_QCOM_OCMEM is not set
# CONFIG_QCOM_LLCC is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_PANTECH_EF71_NT35695=y
# Charger and fuel gauge
CONFIG_CHARGER_QCOM_SMBCHG=y
CONFIG_BATTERY_PMI8994_FG=y
# Android userspace (TWRP, LineageOS)
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_FUSE_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_PSI=y
CONFIG_INPUT_UINPUT=y
# Touch
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
# Remote processors, Wi-Fi, BT, modem and venus load firmware: modules,
# loaded once the firmware partitions are mounted
CONFIG_QCOM_Q6V5_PAS=m
# Haptics and flash LED
CONFIG_INPUT_QCOM_SPMI_HAPTICS=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_QCOM_FLASH_V1=y
# Firmware comes from the firmware_class.path set on the command line:
# no sysfs fallback, which stalls the boot for a minute on every lookup
# made before ueventd runs
# CONFIG_FW_LOADER_USER_HELPER is not set
# Android first stage mount
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
