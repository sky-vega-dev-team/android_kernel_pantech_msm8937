# Pantech VEGA IRON 2 (EF71)
#
# On top of:
#   vendor/msm8937-perf_defconfig vendor/common.config
#   vendor/msm8937-legacy.config

# Localversion
CONFIG_LOCALVERSION="-ef71"

# Device tree
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="pantech-msm8937/ef71s"

# Mach
CONFIG_MACH_PANTECH_MSM8937=y
CONFIG_MACH_MSM8937_EF71S=y

# Power supply (stock QPNP drivers until the Pantech ones are ported)
CONFIG_QPNP_FG=y
CONFIG_QPNP_SMBCHARGER=y

# The Android 10 build forbids cpio in the kernel build, and nothing
# reads /sys/kernel/kheaders.tar.xz on Android 10
# CONFIG_IKHEADERS is not set

# Storage: LineageOS 17.1 (Android 10) still uses sdcardfs
CONFIG_SDCARD_FS=y

# Camera: the EF71 mm-camera blobs date from the Marshmallow camera_v2
CONFIG_MSMB_CAMERA_LEGACY_M=y
CONFIG_PANTECH_CAMERA=y
# Only the legacy-m stack: the default camera_v2 one registers the same drivers
# CONFIG_MSMB_CAMERA_ENABLE is not set

# Input
CONFIG_INPUT_GPIO_WHEEL_ALPS_EC05E=y

# LEDs
CONFIG_LEDS_LP5523_PANTECH=y

# Touchscreen
CONFIG_TOUCHSCREEN_ATMEL_MXT641T_PANTECH=y
CONFIG_TOUCHSCREEN_FT8716_PANTECH=y
